{
  "expo": {
    "name": "APS - Auto Service",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aps",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#F97316",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aps.autoservice",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "APS needs camera access so mechanics can photograph installed parts and service work, and so customers can capture vehicle damage.",
        "NSPhotoLibraryUsageDescription": "APS needs photo library access so you can attach photos to service requests, work logs, and vehicle records.",
        "NSPhotoLibraryAddUsageDescription": "APS may save photos of completed service work to your photo library.",
        "NSLocationWhenInUseUsageDescription": "APS uses your location to match you with nearby mechanics, route mobile mechanics to your vehicle, and verify service location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mechanics share live location with customers during active jobs so customers can track their arrival in real time.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aps.autoservice",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0E1A",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#0A0E1A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F97316",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "APS accesses your photos so you can attach images to service requests, work logs, and vehicle records.",
          "cameraPermission": "APS uses the camera so you can photograph vehicle issues and installed parts."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "APS uses your location to match you with nearby mechanics and to share live ETA during active jobs.",
          "locationWhenInUsePermission": "APS uses your location to match you with nearby mechanics."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/**/*",
      "data/**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {}
  }
}
