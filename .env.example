# =============================================================================
# APS — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- REQUIRED ----------------------------------------------------------------

# Postgres connection string (Drizzle ORM)
DATABASE_URL=postgres://user:password@host:5432/aps

# JWT signing secret. Must be >= 32 chars in production.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- OPTIONAL ----------------------------------------------------------------

# Server log level (debug | info | warn | error). Defaults to info.
LOG_LEVEL=info

# Node environment.
NODE_ENV=development

# Public base URL for password-reset emails, referral links, etc.
# Falls back to REPLIT_DOMAINS / REPLIT_DEV_DOMAIN when running on Replit.
PUBLIC_BASE_URL=https://your-domain.example.com
APP_BASE_URL=https://your-domain.example.com

# One-time admin bootstrap key for POST /auth/admin/setup.
ADMIN_SETUP_KEY=

# Mobile dev: domain used by the Expo client to reach the API server.
# In Replit dev this is auto-injected; locally set to your tunnel/IP.
EXPO_PUBLIC_DOMAIN=

# Marketing links shown in mechanic amplification screens.
APP_STORE_URL=
PLAY_STORE_URL=

# --- INTEGRATIONS (configure if/when you turn the feature on) ----------------

# Stripe — payments + Connect onboarding (server-side keys handled via
# Replit Stripe Connector in this project; for self-hosted add STRIPE_SECRET_KEY
# and STRIPE_WEBHOOK_SECRET here).

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio — SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PartsTech (parts supplier — currently a stub adapter; wire later)
PARTSTECH_API_KEY=
PARTSTECH_SHOP_ID=
